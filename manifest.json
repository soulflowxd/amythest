{
  "manifest_version": 3,
  "name": "Amythest — mindful screen time",
  "short_name": "Amythest",
  "version": "0.1.0",
  "description": "See where your time goes and make space to focus.",
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Amythest" },
  "options_page": "dashboard.html",
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.js", "styles.css"], "matches": ["<all_urls>"] }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
